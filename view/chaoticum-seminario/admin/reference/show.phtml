</table>

<?php if (!$preview['supportsCreation']): ?>
<p class="messages"><em><?php echo sprintf($translate('Le type "%s" n\'est pas encore pris en charge pour l\'ajout automatique de référence (seul le type "personne" l\'est) ; les résultats Wikidata sont affichés à titre indicatif.'), $preview['type']); ?></em></p>
<?php endif; ?>

<h3><?php echo $translate('Résultats Wikidata'); ?><?php if ($preview['searchQuery'] !== ''): ?> — <?php echo sprintf($translate('pour « %s »'), $escape($preview['searchQuery'])); ?><?php endif; ?></h3>

<?php
$searchForm = function () use ($translate, $escape, $reference, $preview) {
    echo '<form method="get" action="' . $escape($this->url('admin/reference/id', ['id' => $reference->id(), 'action' => 'show'])) . '">';
    echo '<label for="q">' . $translate('Recherche libre sur Wikidata') . '</label> ';
    echo '<input type="text" id="q" name="q" value="' . $escape($preview['searchQuery']) . '">';
    echo ' <button type="submit" class="button">' . $translate('Rechercher') . '</button>';
    echo '</form>';
};
?>

<?php if ($preview['searchQuery'] === ''): ?>
<p><?php echo $translate('La description de la référence est vide, impossible de lancer une recherche automatique.'); ?></p>
<?php $searchForm(); ?>
<?php elseif ($preview['searchError']): ?>
