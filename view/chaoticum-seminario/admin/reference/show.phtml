                <?php if ($candidate['description'] !== ''): ?>
                <br><em><?php echo $escape($candidate['description']); ?></em>
                <?php endif; ?>
            </td>
            <td>
                <?php if ($preview['supportsCreation'] && $transcription): ?>
                <form method="post" action="<?php echo $escape($this->url('admin/reference/id', ['id' => $reference->id(), 'action' => 'run'])); ?>">
                    <input type="hidden" name="qid" value="<?php echo $escape($candidate['qid']); ?>">
                    <button type="submit" class="button"><?php echo $translate('Ajouter à la transcription visée'); ?></button>
                </form>
                <?php endif; ?>

                <?php if ($preview['supportsCreation'] && $preview['surTout'] && $preview['siblings']): ?>
                <form method="post" action="<?php echo $escape($this->url('admin/reference/id', ['id' => $reference->id(), 'action' => 'run-all'])); ?>">
                    <input type="hidden" name="qid" value="<?php echo $escape($candidate['qid']); ?>">
                    <button type="submit" class="button"><?php echo sprintf($translate('Ajouter à toutes les transcriptions sœurs (%d)'), count($preview['siblings'])); ?></button>
                </form>
                <details>
                    <summary><?php echo $translate('Lancer individuellement sur chaque transcription sœur'); ?></summary>
                    <table class="tablesaw" data-tablesaw-mode="stack">
                        <thead>
                            <tr>
                                <th><?php echo $translate('Transcription'); ?></th>
                                <th><?php echo $translate('Audio'); ?></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($preview['siblings'] as $sibling): ?>
