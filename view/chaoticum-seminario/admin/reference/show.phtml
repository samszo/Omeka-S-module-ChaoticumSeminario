                                <td><a href="<?php echo $escape($sibling->url()); ?>">#<?php echo $sibling->id(); ?></a> — <?php echo $highlight($excerpt($sibling->displayTitle(), $description), $description); ?></td>
                                <td><?php echo $audioPlayer($sibling); ?></td>
                                <td>
                                    <form method="post" action="<?php echo $escape($this->url('admin/reference/id', ['id' => $reference->id(), 'action' => 'run'])); ?>">
                                        <input type="hidden" name="qid" value="<?php echo $escape($candidate['qid']); ?>">
                                        <input type="hidden" name="transcription_id" value="<?php echo $escape($sibling->id()); ?>">
                                        <button type="submit" class="button"><?php echo $translate('Lancer'); ?></button>
                                    </form>
                                </td>
                            </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                </details>
                <?php endif; ?>
            </td>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>
<?php endif; ?>
