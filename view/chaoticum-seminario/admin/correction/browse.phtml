<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

$this->htmlElement('body')->appendAttribute('class', 'chaoticum-seminario-correction browse');

$query = $this->params()->fromQuery();

$sortLink = function ($label, $sortKey) use ($sortBy, $sortOrder, $query, $escape, $translate) {
    $nextOrder = ($sortBy === $sortKey && $sortOrder === 'asc') ? 'desc' : 'asc';
    $newQuery = array_replace($query, ['sort_by' => $sortKey, 'sort_order' => $nextOrder]);
    $arrow = '';
    if ($sortBy === $sortKey) {
        $arrow = $sortOrder === 'asc' ? ' ▲' : ' ▼';
    }
    return sprintf(
        '<a href="%s">%s%s</a>',
        $escape($this->url(null, [], ['query' => $newQuery], true)),
        $escape($translate($label)),
        $arrow
    );
};
?>

<?php echo $this->pageTitle($translate('Corrections de transcription')); ?>

<div class="browse-controls">
    <?php echo $this->pagination(); ?>
</div>

<?php if (!$corrections): ?>
<p><?php echo $translate('Aucune correction de transcription trouvée.'); ?></p>
<?php else: ?>
<table class="tablesaw" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <th><?php echo $translate('Titre'); ?></th>
            <th><?php echo $sortLink('Date', 'created'); ?></th>
            <th><?php echo $sortLink('Status', 'curation:status'); ?></th>
            <th><?php echo $translate('Remplacer'); ?></th>
            <th><?php echo $translate('Par'); ?></th>
            <th><?php echo $translate('Sur tout'); ?></th>
            <th><?php echo $translate('Transcription'); ?></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($corrections as $correction): ?>
        <?php $source = $correction->value('dcterms:source'); ?>
        <tr>
            <td><a href="<?php echo $escape($this->url('admin/correction/id', ['id' => $correction->id()])); ?>"><?php echo $escape($correction->displayTitle()); ?></a></td>
            <td><?php echo $this->i18n()->dateFormat($correction->created()); ?></td>
            <td><?php echo $escape((string) $correction->value('curation:status')); ?></td>
            <td><?php echo $escape((string) $correction->value('jdc:remplacer')); ?></td>
            <td><?php echo $escape((string) $correction->value('jdc:par')); ?></td>
            <td><?php echo $escape((string) $correction->value('jdc:surTout')); ?></td>
            <td><?php if ($source && $source->valueResource()):
                $target = $source->valueResource();
                $shortTitle = mb_substr($target->displayTitle(), 0, 60) . (mb_strlen($target->displayTitle()) > 60 ? '…' : '');
                ?>
                <a href="<?php echo $escape($target->url()); ?>" title="<?php echo $escape($target->displayTitle()); ?>">#<?php echo $target->id(); ?> — <?php echo $escape($shortTitle); ?></a>
            <?php endif; ?></td>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>
<?php endif; ?>
