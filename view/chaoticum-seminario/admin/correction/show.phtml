<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

$this->htmlElement('body')->appendAttribute('class', 'chaoticum-seminario-correction show');

$transcription = $preview['transcription'];
$remplacer = $preview['remplacer'];

/**
 * Échappe $text puis entoure les occurrences (insensibles à la casse) de
 * $needle avec un <mark> coloré, pour repérer visuellement "remplacer".
 */
$highlight = function ($text, $needle) use ($escape) {
    $escaped = $escape((string) $text);
    $needle = trim((string) $needle);
    if ($needle === '') {
        return $escaped;
    }
    $escapedNeedle = $escape($needle);
    return preg_replace('/' . preg_quote($escapedNeedle, '/') . '/ui', '<mark class="cs-highlight">$0</mark>', $escaped);
};

/**
 * Extrait un court passage du texte autour de la première occurrence de
 * $needle (ou le début du texte si non trouvé), pour éviter d'afficher un
 * transcript entier dans une liste.
 */
$excerpt = function ($text, $needle, $context = 60) {
    $text = (string) $text;
    $needle = trim((string) $needle);
    $pos = $needle !== '' ? mb_stripos($text, $needle) : false;
    if ($pos === false) {
        $snippet = mb_substr($text, 0, $context * 2);
        return $snippet . (mb_strlen($text) > $context * 2 ? '…' : '');
    }
    $start = max(0, $pos - $context);
    $len = mb_strlen($needle) + $context * 2;
    $snippet = mb_substr($text, $start, $len);
    return ($start > 0 ? '…' : '') . $snippet . (($start + $len) < mb_strlen($text) ? '…' : '');
};

/**
 * Lecteur audio du fragment source (oa:hasSource) d'une transcription, s'il existe.
 */
$audioPlayer = function ($item) use ($escape) {
    if (!$item) {
        return '';
    }
    $source = $item->value('oa:hasSource');
    $media = $source ? $source->valueResource() : null;
    if (!$media) {
        return '';
    }
    return '<audio controls preload="none" style="max-width:360px;width:100%;display:block;margin-top:0.25em;">'
        . '<source src="' . $escape($media->originalUrl()) . '" type="' . $escape($media->mediaType()) . '">'
        . '</audio>';
};
?>
<style>
.cs-highlight { background: #fff2a8; color: #7a4a00; font-weight: 600; padding: 0 2px; border-radius: 2px; }
</style>

<?php echo $this->pageTitle($correction->displayTitle()); ?>

<div id="page-actions">
