    </tbody>
</table>

<?php if ($transcription): ?>
<h3><?php echo $translate('Aperçu des correspondances'); ?></h3>
<ul>
    <li><?php echo sprintf($translate('Titre : %d occurrence(s)'), $preview['titleMatches']); ?></li>
    <li><?php echo sprintf($translate('Segments (part of speech) : %d occurrence(s)'), $preview['segmentationMatches']); ?></li>
    <li><?php echo sprintf($translate('Suites de mots-concepts (data) : %d occurrence(s)'), $preview['dataMatches']); ?></li>
</ul>

<form method="post" action="<?php echo $escape($this->url('admin/correction/id', ['id' => $correction->id(), 'action' => 'run'])); ?>">
    <button type="submit" class="button"><?php echo $translate('Lancer la correction sur cette transcription'); ?></button>
</form>
<?php endif; ?>

<?php if ($preview['surTout']): ?>
